<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         id="WebApp_ID" version="2.5">
    <display-name>LocalDevelopment~rsug.io~demoecho</display-name>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <filter>
        <filter-name>WicketApplication</filter-name>
        <filter-class>org.apache.wicket.protocol.http.WicketFilter</filter-class>
        <init-param>
            <param-name>applicationClassName</param-name>
            <!-- Укажите полный путь к вашему классу приложения -->
            <param-value>demoecho.HelloWorldApplication</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>WicketApplication</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <description>Сервлет админки</description>
        <display-name>EchoAdapterServlet</display-name>
        <servlet-name>EchoAdapterServlet</servlet-name>
        <servlet-class>demoecho.EchoAdapterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EchoAdapterServlet</servlet-name>
        <url-pattern>/echo</url-pattern>
    </servlet-mapping>

</web-app>